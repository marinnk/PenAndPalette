# このファイルをコピーして .env を作成する（.env はコミットしない）
# cp .env.example .env

# 開発用のダミー値。本番（DJANGO_DEBUG=false）では未設定だと起動しない。
# 本番は Secrets Manager 等で 50 文字以上のランダム値を注入すること。
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-0123456789abcdefghij
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# docker-compose.yml のMySQLサービスに合わせたデフォルト値
DB_NAME=pen_and_palette
DB_USER=pen_and_palette
DB_PASSWORD=pen_and_palette
DB_HOST=127.0.0.1
DB_PORT=3306

# Vite dev server（別オリジンからのCORS許可。複数指定時はカンマ区切り）
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 認証Cookie（access_token/refresh_token）のsecure属性。未設定時はDJANGO_DEBUGの逆（本番相当ならtrue）
# ローカル開発はHTTPのため既定でfalseになる。明示的に上書きしたい場合のみ設定する
# AUTH_COOKIE_SECURE=false

# 画像ストレージ（S3 / 開発時はMinIO）。docker-compose.ymlのminioサービスに合わせたデフォルト値
AWS_S3_BUCKET=pen-and-palette-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_REGION_NAME=us-east-1

# --- 以下は本番（AWS）用。ローカル開発では設定不要 ---
# CloudFront ドメイン経由の CORS / CSRF 許可（scheme 付き・カンマ区切り）
# CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.cloudfront\.net$
# CSRF_TRUSTED_ORIGINS=https://dxxxxxxxxxxxxx.cloudfront.net
# 本番 S3 は virtual-hosted-style を使える（MinIO は path のまま）
# AWS_S3_ADDRESSING_STYLE=virtual
# HSTS の秒数（既定 0 = 無効）。独自ドメイン導入までは 0 のままにする
# SECURE_HSTS_SECONDS=0
# CloudWatch Logs 向けに 1 行 JSON ログを出す
# LOG_FORMAT=json
