# このファイルをコピーして .env を作成する（.env はコミットしない）
# cp .env.example .env

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# docker-compose.yml のMySQLサービスに合わせたデフォルト値
DB_NAME=pen_and_palette
DB_USER=pen_and_palette
DB_PASSWORD=pen_and_palette
DB_HOST=127.0.0.1
DB_PORT=3306

# Vite dev server（別オリジンからのCORS許可。複数指定時はカンマ区切り）
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 認証Cookie（access_token/refresh_token）のsecure属性。未設定時はDJANGO_DEBUGの逆（本番相当ならtrue）
# ローカル開発はHTTPのため既定でfalseになる。明示的に上書きしたい場合のみ設定する
# AUTH_COOKIE_SECURE=false
