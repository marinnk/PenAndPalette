# OS
.DS_Store

# Environment
.env
.env.local

# Python / Django
__pycache__/
*.pyc
.venv/
venv/
*.sqlite3
staticfiles/

# Node / Vue
node_modules/
dist/
.vite/

# E2E (Playwright)
e2e/results/
e2e/test-results/
e2e/playwright-report/

# Terraform（.terraform.lock.hcl はプロバイダのバージョン固定のためコミット対象に残す）
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/crash.log
terraform/crash.*.log
terraform/*.tfplan
terraform/tfplan
terraform/override.tf
terraform/override.tf.json
terraform/*_override.tf
terraform/*_override.tf.json
*.tfvars

# perf-tests（node_modules は各サブディレクトリの .gitignore、レポートは results/.gitignore）
perf-tests/**/node_modules/
perf-tests/results/*
!perf-tests/results/.gitignore

# Editors
.vscode/
.idea/
