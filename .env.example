# このファイルをコピーして .env を作成する（.env はコミットしない）
# cp .env.example .env
# docker compose up -d はこの .env を読み込む（backend/.env とは別ファイル）

DB_NAME=pen_and_palette
DB_USER=pen_and_palette
DB_PASSWORD=pen_and_palette
DB_ROOT_PASSWORD=root
DB_PORT=3306

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_S3_BUCKET=pen-and-palette-media
